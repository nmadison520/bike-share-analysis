#return a list of names from a DataFrame df where 'score' is the column greater 
#than or equal to a given threshold
#make a copy of the data frame 
#drop rows with missing scores, filter rows where score>= threshold
#sort by score, return the list of names

def high_scores(df, threshold):
    #filter just to the column score
    temp=df.copy()
    temp= temp.dropna()#drops something but doesn't edit temp, just returns data frame/doesn't update
    #set temp=temp.dropna() in order to update 
    temp= temp[ temp["score"]>=threshold ]
    temp= temp.sort_values("score")
    return temp['name'].tolist()

#write the testing class that throughly tests the following classes
#from abc import ABC, abstractmethod

class Shape(ABC):
    @abstractmethod
    def area(self):
        pass

    def __eq__(self, other):
       if self is other:
            return True
       if type(self) is type(other):
            return abs(self.area() - other.area()) < 1e-6
       return NotImplemented
class Rectangle(Shape):
    def __init__(self, width, height):
        self.width = width
        self.height = height
    def area(self):
        return self.width * self.height

import unittest 

class Test Rectangle(unittest.TestCase):
    def setUp(self):
        self.rect1= Rectangle(7, 8)
        self.rect2= Rectangle(7, 8)
        self.rect3= Rectangle(8, 9)
    def test__eq__(self):
        self.assertTrue(self.rect1==self.rect1)
        self.assertTrue(self.rect1==self.rect2)
        self.assertFalse(self.rect1==self.rect3)
        self.assertFalse(self.rect1=="Bananas")
    def test_area(self):
        rect4= Rectangle(1, 1)
        expected_value= 1
        result= rect4.area()
        self.assertEqual(result, expected_value)
